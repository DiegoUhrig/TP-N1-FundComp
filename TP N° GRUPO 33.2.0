          <tr><td>Refrigeraci├│n</td><td>Integrada (port├ítil)</td><td>Watercooler 360 mm</td><td>Cooler stock</td><td>Cooler stock</td></tr>
          <tr><td>Placa madre</td><td>ÔÇö (notebook)</td><td>Gigabyte B550M Gaming X WiFi6</td><td>Gigabyte B650M-H</td><td>MSI B450M PRO-VDH MAX</td></tr>
          <tr><td>Memoria RAM</td><td>DDR5 16GB (2├ù8GB) 5600MHz (SODIMM)</td><td>DDR4 16GB 3200MHz</td><td>DDR5 16GB 5600MHz</td><td>DDR4 16GB 3200MHz</td></tr>
          <tr><td>Almacenamiento</td><td>SSD 512GB PCIe Gen4</td><td>SSD 1TB ADATA Leg. 860 NVMe Gen4</td><td>SSD 256GB NVMe</td><td>SSD 500GB NVMe</td></tr>
          <tr><td>Tarjeta gr├ífica (GPU)</td><td>Gr├ífica integrada (Radeon 680M)</td><td>GeForce RTX 3050 6GB</td><td>ASRock Radeon RX 7600 8GB</td><td>GeForce RTX 4060 8GB</td></tr>
          <tr><td>Fuente</td><td>ÔÇö (notebook)</td><td>Gigabyte GP-P550SS 550W 80+ Silver</td><td>MSI MAG A650BN 650W 80+ Bronze</td><td>Corsair CV650 650W 80+ Bronze</td></tr>
          <tr><td>Monitor</td><td>15.6" FHD (integrado)</td><td>Asus 24" FHD 100Hz IPS</td><td>Solarmax 19"</td><td>LG 22" 1080p</td></tr>
          <tr><td>Gabinete</td><td>ÔÇö (notebook)</td><td>Evolabs Bolt TG</td><td>Zer01 Centauri 3</td><td>Cooler Master Q300L</td></tr>
          <tr><td>Perif├®ricos incluidos</td><td>Mouse, auricular, webcam</td><td>Mouse, teclado, monitor</td><td>Teclado+mouse, micr├│fono, auriculares</td><td>Kit teclado+mouse, auriculares</td></tr>
          <tr><td>Sistema operativo</td><td>Windows 11 Home (licencia)</td><td>Windows 11 Home (OEM)</td><td>ÔÇö</td><td>ÔÇö</td></tr>
